# Copy to .env.test for isolated synthetic tests. Never point this file at production.
APP_ENV=test
APP_VERSION=test
PORT=0
LOG_LEVEL=silent
DATABASE_URL=postgresql://bnbu_test:CHANGE_ME_TEST_ONLY@127.0.0.1:55432/bnbu_sports_test?schema=public
MIGRATION_DATABASE_URL=postgresql://bnbu_test:CHANGE_ME_TEST_ONLY@127.0.0.1:55432/bnbu_sports_test?schema=public
TEST_DATABASE_URL=postgresql://bnbu_test:CHANGE_ME_TEST_ONLY@127.0.0.1:55432/bnbu_sports_test?schema=public
TEST_DATABASE_RESET_CONFIRMATION=BNBU_SPORTS_EPHEMERAL_TEST_DATABASE_V1
TOKEN_ISSUER=bnbu-sports-test
TOKEN_AUDIENCE=bnbu-sports-test-clients
TOKEN_SIGNING_KEY=CHANGE_ME_TEST_PRIVATE_KEY
TOKEN_VERIFYING_KEY=CHANGE_ME_TEST_PUBLIC_KEY
ACCESS_TOKEN_TTL=CHANGE_ME_EXPLICIT_DURATION
REFRESH_TOKEN_ABSOLUTE_TTL=CHANGE_ME_EXPLICIT_DURATION
REFRESH_TOKEN_IDLE_TTL=CHANGE_ME_EXPLICIT_DURATION
IDEMPOTENCY_RETENTION=CHANGE_ME_EXPLICIT_DURATION
IDEMPOTENCY_LEASE=CHANGE_ME_EXPLICIT_DURATION
IDEMPOTENCY_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_TEST_ONLY_KEY
SECURITY_HASH_KEY=CHANGE_ME_TEST_ONLY
AUTH_RATE_LIMIT_WINDOW_SECONDS=CHANGE_ME_EXPLICIT_DURATION
AUTH_RATE_LIMIT_MAX_ATTEMPTS=CHANGE_ME_EXPLICIT_INTEGER
CORS_ALLOWLIST=http://127.0.0.1:3001
TRUST_PROXY=false
SYSTEM_MODE_SOURCE=database
REQUEST_BODY_LIMIT_BYTES=2097152
REQUEST_TIMEOUT_MS=10000
COURSE_INVITE_TTL_SECONDS=CHANGE_ME_EXPLICIT_DURATION
JOIN_CAPABILITY_TTL_SECONDS=CHANGE_ME_EXPLICIT_DURATION
QR_JOIN_TOKEN_HASH_KEY=CHANGE_ME_BASE64_32_BYTE_TEST_ONLY_KEY
QR_JOIN_SECRET_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_TEST_ONLY_KEY
QR_JOIN_SECRET_REPLAY_SECONDS=CHANGE_ME_EXPLICIT_DURATION
QR_JOIN_PUBLIC_RATE_LIMIT_WINDOW_SECONDS=CHANGE_ME_EXPLICIT_DURATION
QR_JOIN_PUBLIC_RATE_LIMIT_MAX_REQUESTS=CHANGE_ME_EXPLICIT_INTEGER
OBJECT_STORAGE_REQUIRED=false
LOCAL_SEED_TEACHER_PASSWORD=CHANGE_ME_TEST_ONLY
LOCAL_SEED_ADMIN_PASSWORD=CHANGE_ME_TEST_ONLY

# OCR: disabled by default. Enable only after configuring the CVM role and OCR permission.
OCR_PROVIDER=DISABLED
OCR_WORKER_ENABLED=false
# OCR_TENCENT_REGION=ap-guangzhou
OCR_TIMEOUT_MS=20000
