{
  "name": "@bnbu/sports-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Greenfield authoritative backend for BNBU Sports",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "prebuild": "npm run db:generate && npm run generate",
    "build": "nest build",
    "start": "node --enable-source-maps dist/main.js",
    "start:dev": "nest start --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src test scripts prisma prisma.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ./scripts/run-test-layer.mjs unit",
    "test:integration": "node ./scripts/run-test-layer.mjs integration",
    "pretest:e2e": "npm run build",
    "test:e2e": "node ./scripts/run-test-layer.mjs e2e",
    "test:contract": "node ./scripts/run-test-layer.mjs contract",
    "test:security": "node ./scripts/run-test-layer.mjs security",
    "test:tencent-cloud-config": "node --test ./scripts/tencent-cloud-configuration.test.mjs",
    "test:docker-runtime-smoke": "node ./scripts/docker-runtime-smoke.mjs",
    "staging:config:check": "node ./scripts/check-staging-configuration.mjs",
    "staging:config:check:files": "node ./scripts/check-staging-configuration.mjs --files",
    "staging:health-operator": "node --enable-source-maps ./dist/tools/staging-health-operator.js",
    "staging:business-operator": "node --enable-source-maps ./dist/tools/staging-business-closure-operator.js",
    "staging:r01-provisioner": "node --enable-source-maps ./dist/tools/staging-r01-provisioning-operator.js",
    "openapi:generate": "node ./scripts/generate-openapi.mjs",
    "openapi:check": "node ./scripts/generate-openapi.mjs --check",
    "db:manifest:generate": "node ./scripts/generate-migration-manifest.mjs",
    "db:manifest:check": "node ./scripts/generate-migration-manifest.mjs --check",
    "generate": "npm run openapi:generate && npm run db:manifest:generate",
    "generate:check": "npm run repo-layout:check && npm run backend-release-policy:check && npm run client-contract-baseline:check && npm run openapi:check && npm run db:manifest:check",
    "repo-layout:check": "node ../tools/repository/check-monorepo-layout.mjs",
    "backend-release-policy:check": "node --test ../tools/repository/check-backend-release-policy.test.mjs && node ../tools/repository/check-backend-release-policy.mjs",
    "client-contract-baseline:check": "node ../tools/repository/check-client-contract-baseline.mjs",
    "contract:check": "npm --prefix ../tools/backend-contracts run contract:check && npm run openapi:check",
    "contract:parity:check": "node ./scripts/check-contract-parity.mjs",
    "contract:compatibility:check": "npm --prefix ../tools/backend-contracts run contract:compatibility:check",
    "contract:release:prepare": "npm --prefix ../tools/backend-contracts run contract:release:prepare",
    "contract:release:check": "npm --prefix ../tools/backend-contracts run contract:release:check",
    "production-closure:inventory:check": "npm --prefix ../tools/backend-contracts run production-closure:inventory:check",
    "runtime-coverage:generate": "node ./scripts/check-runtime-coverage.mjs --write",
    "runtime-coverage:check": "node ./scripts/check-runtime-coverage.mjs",
    "runtime-conformance:check": "node ./scripts/check-runtime-conformance-report.mjs",
    "runtime-conformance:write": "node ./scripts/check-runtime-conformance-report.mjs --write",
    "local:env:init": "node ../tools/local-integration/initialize-local-environment.mjs",
    "local:env:check": "node ../tools/local-integration/check-local-environment.mjs",
    "local:closure": "node ../tools/local-integration/run-synthetic-record-closure.mjs",
    "test:local-tools": "node --test ../tools/local-integration/environment-config.test.mjs && node --check ../tools/local-integration/initialize-local-environment.mjs && node --check ../tools/local-integration/check-local-environment.mjs && node --check ../tools/local-integration/run-synthetic-record-closure.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "node ./scripts/run-migration-with-secrets.mjs",
    "db:migrate:deploy:container": "node ./scripts/run-migration-with-secrets.mjs --harden",
    "db:migration:check": "node ./scripts/check-migration-safety.mjs",
    "test:migration-safety": "node --test ./scripts/check-migration-safety.test.mjs",
    "db:migration:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "db:schema:drift:check": "prisma migrate diff --from-schema prisma/schema.prisma --to-config-datasource --exit-code",
    "db:seed:local": "prisma db seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1102.0",
    "@aws-sdk/lib-storage": "3.1102.0",
    "@aws-sdk/s3-request-presigner": "3.1102.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "0.45.1",
    "busboy": "1.6.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "csv-parse": "7.0.2",
    "dotenv": "17.4.2",
    "helmet": "8.3.0",
    "jose": "6.2.7",
    "nestjs-pino": "4.6.1",
    "nodemailer": "9.0.5",
    "pg": "8.16.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "tencentcloud-sdk-nodejs-common": "4.0.825",
    "tencentcloud-sdk-nodejs-ses": "4.1.271",
    "uuid": "14.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/busboy": "1.5.4",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.20.3",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tsx": "4.23.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "yaml": "2.9.0"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.2.3"
    },
    "deepmerge-ts": "8.0.1"
  }
}
