FROM node:24.18.0-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python-is-python3 python3-yaml && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace/BNBU-Sports-Web-new/portal-teacher-admin
COPY BNBU-Sports-Web-new/portal-teacher-admin/package.json BNBU-Sports-Web-new/portal-teacher-admin/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY BNBU-Sports-Web-new/portal-teacher-admin/ ./
COPY BNBU-Sports-Web-new/frontend/student/ ../frontend/student/
COPY contracts/ /workspace/contracts/
CMD ["npm", "run", "typecheck"]
