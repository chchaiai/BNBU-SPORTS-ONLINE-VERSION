# Production configuration. Secret values are read from private mounted JSON files.
APP_ENV=production
APP_VERSION=bugfix-20260910
PORT=3000
LOG_LEVEL=info
RUNTIME_LOG_DIRECTORY=/var/log/bnbu-sports
RUNTIME_SECRET_PROVIDER=FILE_JSON
RUNTIME_SECRET_FILE=/run/secrets/runtime.json
MIGRATOR_SECRET_FILE=/run/secrets/migrator.json
TENCENTDB_CA_FILE=/run/secrets/tencentdb-ca-chain.pem
POSTGRES_APP_USER=bnbusports_app
TOKEN_ISSUER=bnbu-sports-production
TOKEN_AUDIENCE=bnbu-sports-production-clients
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_ABSOLUTE_TTL=2592000
REFRESH_TOKEN_IDLE_TTL=604800
IDEMPOTENCY_RETENTION=86400
IDEMPOTENCY_LEASE=300
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
CORS_ALLOWLIST=https://www.student.bnbusports.cn,https://www.teacher.bnbusports.cn
TRUST_PROXY=true
SYSTEM_MODE_SOURCE=database
PUBLIC_ORGANIZATION_CODE=BNBU
REQUEST_BODY_LIMIT_BYTES=2097152
REQUEST_TIMEOUT_MS=10000
COURSE_INVITE_TTL_SECONDS=604800
JOIN_CAPABILITY_TTL_SECONDS=600
QR_JOIN_SECRET_REPLAY_SECONDS=86400
QR_JOIN_PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
QR_JOIN_PUBLIC_RATE_LIMIT_MAX_REQUESTS=60
PUSH_TOKEN_ENCRYPTION_KEY_VERSION=1
STORAGE_CREDENTIAL_PROVIDER=TENCENT_CVM_ROLE
OBJECT_STORAGE_REQUIRED=true
OBJECT_STORAGE_ENDPOINT=https://cos.ap-hongkong.myqcloud.com
OBJECT_STORAGE_REGION=ap-hongkong
OBJECT_STORAGE_BUCKET=bnbu-sports-prod-hk-1443273655
OBJECT_STORAGE_FORCE_PATH_STYLE=false
MEDIA_STORAGE_REQUIRED=true
MEDIA_STORAGE_ENDPOINT=https://cos.ap-hongkong.myqcloud.com
MEDIA_STORAGE_REGION=ap-hongkong
MEDIA_STORAGE_BUCKET=bnbu-sports-prod-hk-1443273655
MEDIA_STORAGE_FORCE_PATH_STYLE=false
MEDIA_UPLOAD_URL_TTL_SECONDS=300
MEDIA_ACCESS_URL_TTL_SECONDS=300
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_IMAGE_PIXELS=40000000
MEDIA_MAX_VIDEO_TRANSPORT_BYTES=536870912
MEDIA_SCANNER_MODE=EXTERNAL_REQUIRED
MEDIA_SCANNER_HOST=/run/clamav/clamd.ctl
MEDIA_WORKER_ENABLED=true
MEDIA_WORKER_POLL_MS=500

# OCR: disabled by default. Enable only after configuring the CVM role and OCR permission.
OCR_PROVIDER=DISABLED
OCR_WORKER_ENABLED=false
# OCR_TENCENT_REGION=ap-hongkong
OCR_TIMEOUT_MS=20000
